<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <queries>
      <intent>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LEANBACK_LAUNCHER"/>
      </intent>
      <intent>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent>
    </queries>
    <application android:label="${glassOnnAppLabel}" android:icon="@drawable/appicon" android:banner="@drawable/banner" android:allowBackup="false" android:usesCleartextTraffic="false" android:theme="@android:style/Theme.Material.NoActionBar" android:supportsRtl="true">
        <activity android:name="com.glassonn.home.MainActivity" android:exported="true" android:screenOrientation="landscape">
           <intent-filter>
             <action android:name="android.intent.action.MAIN"/>
             <category android:name="android.intent.category.LAUNCHER"/>
             <category android:name="android.intent.category.LEANBACK_LAUNCHER"/>
           </intent-filter>
           <!-- Qualify as a Home candidate; Android/TV firmware remains in control of selection. -->
           <intent-filter>
             <action android:name="android.intent.action.MAIN"/>
             <category android:name="android.intent.category.HOME"/>
             <category android:name="android.intent.category.DEFAULT"/>
           </intent-filter>
        </activity>
    </application>
</manifest>
